{
  "name": "@hxym18/analytics",
  "version": "0.3.0",
  "description": "统计接入 SDK：Umami 脚本 + 路径门控（带 token/私有路由绝不挂统计）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everythingIsZero/analytics.git"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.mjs",
      "default": "./src/react.mjs"
    },
    "./react/client": {
      "types": "./src/react-client.d.ts",
      "import": "./src/react-client.mjs",
      "default": "./src/react-client.mjs"
    },
    "./react/client/base": {
      "types": "./src/react-client-base.d.ts",
      "import": "./src/react-client-base.mjs",
      "default": "./src/react-client-base.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "src/react.d.ts"
      ],
      "react/client": [
        "src/react-client.d.ts"
      ],
      "react/client/base": [
        "src/react-client-base.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "hxym18": {
    "contracts": {
      "sensitive-prefixes": "1+262b9b7c",
      "analytics-policy": "1+0106d6c5",
      "contracts": "1+2ca48235"
    }
  }
}
